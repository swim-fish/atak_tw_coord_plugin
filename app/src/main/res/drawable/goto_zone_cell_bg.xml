<?xml version="1.0" encoding="utf-8"?>
<!-- Projection-zone 121/119 segmented cell background. state_checked = cyan border + cyan fill;
     default = faint border. Mutual exclusion is handled by the RadioGroup, so state_checked alone
     drives the correct colouring. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="#4740A0D0"/>
            <stroke android:width="2dp" android:color="#33CCFF"/>
            <corners android:radius="7dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1AFFFFFF"/>
            <stroke android:width="1dp" android:color="#57FFFFFF"/>
            <corners android:radius="7dp"/>
        </shape>
    </item>
</selector>
