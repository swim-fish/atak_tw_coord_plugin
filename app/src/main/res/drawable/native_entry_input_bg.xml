<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#0AFFFFFF" />
            <stroke android:width="1.5dp" android:color="#33FFFFFF" />
            <corners android:radius="7dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#14FFFFFF" />
            <stroke android:width="2dp" android:color="#FF80CBC4" />
            <corners android:radius="7dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0FFFFFFF" />
            <stroke android:width="1.5dp" android:color="#57FFFFFF" />
            <corners android:radius="7dp" />
        </shape>
    </item>
</selector>
