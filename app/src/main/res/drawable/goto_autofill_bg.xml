<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Fill header button ("Use map centre"). state_enabled=false dims it, mirroring
     refreshAutoFillEnabled()'s setEnabled on goto_autofill. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#0AFFFFFF"/>
            <stroke android:width="1.5dp" android:color="#1AFFFFFF"/>
            <corners android:radius="7dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1F33CCFF"/>
            <stroke android:width="1.5dp" android:color="#8C33CCFF"/>
            <corners android:radius="7dp"/>
        </shape>
    </item>
</selector>
