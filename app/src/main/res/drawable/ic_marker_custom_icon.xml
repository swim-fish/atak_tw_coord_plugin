<?xml version="1.0" encoding="utf-8"?>
<!-- Custom Icon (9th MarkerMode option) — 2x2 multi-color tile grid with a small picker
     cursor in the lower-right corner, signalling "pick an icon from the host's iconset
     library". Distinct from the 8 existing marker-mode drawables (which all use a single
     MIL-STD-2525-style frame + glyph). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- 2x2 grid of color tiles (4 cells, each 8x8 with 1 dp gap). -->
    <path
        android:fillColor="#4A90E2"
        android:pathData="M3,3 L11,3 L11,11 L3,11 Z"/>
    <path
        android:fillColor="#E94B3C"
        android:pathData="M13,3 L21,3 L21,11 L13,11 Z"/>
    <path
        android:fillColor="#7ED321"
        android:pathData="M3,13 L11,13 L11,21 L3,21 Z"/>
    <path
        android:fillColor="#F5A623"
        android:pathData="M13,13 L21,13 L21,21 L13,21 Z"/>
    <!-- White picker cursor overlay in the lower-right cell -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M16,15 L20,17 L18.2,17.5 L20,21 L18.5,21.8 L16.7,18.3 L15.2,19.6 Z"/>
</vector>
