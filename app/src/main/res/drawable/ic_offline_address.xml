<?xml version="1.0" encoding="utf-8"?>
<!--
    Tools-menu silhouette icon for the Offline Address page (feature 004).
    Placeholder per T001 — final visual refined in T058 (map-pin +
    magnifying-glass motif). Pure white stroke + fill on a fully
    transparent canvas, matching the sibling ic_tw_coord.xml and
    ic_tw_coord_goto.xml conventions (see docs/adr/0012-tw-icon-asset-pipeline.md).

    Composition (placeholder):
      - Lowercase "tw" label in the top-left corner (Taiwan flavour)
      - Map-pin teardrop body, centred, with a small hollow circle for the
        pin's inset
      - Underline bar suggesting an address line

    Viewport 192×192.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="192"
    android:viewportHeight="192">

    <!-- Lowercase "tw" label (same path data as ic_tw_coord_goto). -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M 18,8 L 18,28 M 10,16 L 26,16 M 30,16 L 35,28 L 40,18 L 45,28 L 50,16"/>

    <!-- Map-pin teardrop body. Outer outline: top semicircle + sloping
         shoulders meeting at the bottom tip (96, 168). -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="8"
        android:fillColor="#00000000"
        android:pathData="M 96,168 L 56,108 a 40,40 0 1,1 80,0 L 96,168 Z"/>

    <!-- Pin inset circle (hollow centre). -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="6"
        android:fillColor="#00000000"
        android:pathData="M 96,68 m -16,0 a 16,16 0 1,0 32,0 a 16,16 0 1,0 -32,0 Z"/>

    <!-- Underline bar — suggests the address text the pin annotates. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 48,178 L 144,178 L 144,184 L 48,184 Z"/>
</vector>
