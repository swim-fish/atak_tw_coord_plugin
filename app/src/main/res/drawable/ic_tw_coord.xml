<?xml version="1.0" encoding="utf-8"?>
<!--
    Tools-menu silhouette icon for the coordinate-unit cycle (feature 001).
    ATAK applies a silhouette tint to Tools-menu drawables, so any filled
    background plate becomes a solid colour block that destroys the glyph.
    This vector therefore renders white-only fill geometry on a fully
    transparent canvas, no plate, no fills.

    Composition (left → right):
      - 4 open corner brackets form an implied tactical-map frame
      - 'T' as 3 thin rectangles (crossbar + upper stem + lower stem),
        split horizontally at y=96..104 to preserve the stencil cut
      - 'W' as 4 thin diagonal parallelogram strokes (8 px wide each),
        meeting at 2 sharp bottom valleys + 1 flat middle top peak.
        Intentionally NOT cut by the stencil line — the four-stroke
        topology already breaks the silhouette enough to read as W
        without help.

    Both letters use an 8 px stroke weight so the TW pair reads as
    visually matched. See docs/adr/0012-tw-icon-asset-pipeline.md for
    the design history, why earlier "thick W with shallow inner V dip"
    revisions read as "Tn", and the script that regenerates downstream
    PNG variants from this vector source.

    Viewport 192×192. Rendered to a 48dp drawable so each viewport unit
    maps to 0.25dp.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="192"
    android:viewportHeight="192">

    <!-- Corner bracket: top-left -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 16,28 L 40,28 L 40,38 L 26,38 L 26,52 L 16,52 Z"/>

    <!-- Corner bracket: top-right -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 176,28 L 152,28 L 152,38 L 166,38 L 166,52 L 176,52 Z"/>

    <!-- Corner bracket: bottom-left -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 16,164 L 40,164 L 40,154 L 26,154 L 26,140 L 16,140 Z"/>

    <!-- Corner bracket: bottom-right -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 176,164 L 152,164 L 152,154 L 166,154 L 166,140 L 176,140 Z"/>

    <!-- T — crossbar (8 px tall, 40 px wide) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 44,56 L 84,56 L 84,64 L 44,64 Z"/>

    <!-- T — upper stem (above stencil cut at y=96) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 60,64 L 68,64 L 68,96 L 60,96 Z"/>

    <!-- T — lower stem (below stencil cut at y=104) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 60,104 L 68,104 L 68,136 L 60,136 Z"/>

    <!-- W — stroke 1: outer-left peak (96-104) down-right to left valley -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 96,56 L 104,56 L 118,136 L 110,136 Z"/>

    <!-- W — stroke 2: left valley up-right to middle-peak left -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 110,136 L 118,136 L 130,56 L 122,56 Z"/>

    <!-- W — stroke 3: middle-peak right down-right to right valley -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 122,56 L 130,56 L 142,136 L 134,136 Z"/>

    <!-- W — stroke 4: right valley up-right to outer-right peak (144-152) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 134,136 L 142,136 L 152,56 L 144,56 Z"/>
</vector>
