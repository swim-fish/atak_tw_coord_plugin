<?xml version="1.0" encoding="utf-8"?>
<!-- Marker-mode cell background (shared by all 8 cells). state_checked = cyan border + cyan fill
     (the selected marker), default = faint border. The 8 RadioButtons are not in one RadioGroup;
     applyMarkerModeUI() drives mutual exclusion via setChecked() per cell, and the state_checked
     change alone re-colours this selector (no programmatic setBackgroundColor needed). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="#4740A0D0"/>
            <stroke android:width="2dp" android:color="#33CCFF"/>
            <corners android:radius="8dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1AFFFFFF"/>
            <stroke android:width="1dp" android:color="#57FFFFFF"/>
            <corners android:radius="8dp"/>
        </shape>
    </item>
</selector>
