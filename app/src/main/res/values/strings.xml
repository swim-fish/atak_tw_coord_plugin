    <string name="pref_coord_unit_summary">Choose Taipower / TWD97 / TWD67</string>
    <string name="pref_ui_language_title">UI language</string>
    <string name="pref_ui_language_summary">Override the plugin\'s UI language</string>

    <!-- Coord unit option labels. -->
    <string name="opt_unit_taipower">Taipower grid (台電座標)</string>
    <string name="opt_unit_twd97">TWD97 / TM2 z121</string>
    <string name="opt_unit_twd67">TWD67 / TM2 z121</string>

    <!-- UI language option labels. -->
    <string name="opt_lang_system">Use system locale</string>
    <string name="opt_lang_en">English</string>
    <string name="opt_lang_zh_tw">中文（正體）</string>
    <string name="opt_lang_ja">日本語</string>

    <!-- Settings accuracy advisory section. -->
    <string name="pref_accuracy_header">Accuracy notice</string>
    <string name="pref_accuracy_title">Datum-shift accuracy</string>
    <string name="pref_accuracy_summary">TWD97: error &lt; 1 m across all coverage areas.\n\nTWD67 typical error:\n• Main island: ±3 to ±5 m\n• Outer islands (Penghu / Kinmen / Matsu): ±10 to ±20 m\n\nTaipower grid is main-island only; outer-island fixes show "out of range" with a WGS84 fallback line.</string>

    <!-- ============================================================
         Feature 002 — TW Coord GoTo input page
         ============================================================ -->

    <!-- Second Tools-menu icon identity. -->
    <string name="app_name_goto">TW Coord GoTo</string>
    <string name="app_desc_goto">Type a Taipower / TWD97 / TWD67 coordinate and ATAK pans + drops a marker.</string>

    <!-- DropDown title shown above the tabs. -->
    <string name="goto_title">Coordinate input</string>

    <!-- Tab labels. -->
    <string name="goto_tab_taipower">Taipower</string>
    <string name="goto_tab_twd97">TWD97</string>
    <string name="goto_tab_twd67">TWD67</string>

    <!-- Input field hints. -->
    <string name="goto_hint_taipower">e.g. H7509 DB4016</string>
    <string name="goto_hint_easting">Easting (m)</string>
    <string name="goto_hint_northing">Northing (m)</string>

    <!-- Zone toggle. -->
    <string name="goto_zone_label">Zone</string>
    <string name="goto_zone_121">121 (main island)</string>
    <string name="goto_zone_119">119 (outer island)</string>

    <!-- Buttons. -->
    <string name="goto_btn_submit">Submit</string>
    <string name="goto_btn_autofill">Auto Fill</string>
    <string name="goto_btn_paste">Paste</string>

    <!-- Inline error reasons (mapped from ParseResult.Invalid.Reason). -->
    <string name="goto_err_empty">Enter a coordinate.</string>
    <string name="goto_err_bad_length">Wrong length.</string>
    <string name="goto_err_bad_letter">Invalid letter — only A–X / A–J allowed.</string>
    <string name="goto_err_reserved_letter_yz">Letters Y and Z are reserved; use A–X.</string>
    <string name="goto_err_bad_zone">Zone must be 121 or 119.</string>
    <string name="goto_err_non_digit">Digits only.</string>
    <string name="goto_err_out_of_range">Outside Taiwan coverage.</string>
    <string name="goto_err_taipower_outer_island">Taipower does not cover outer islands.</string>

    <!-- Outer-island accuracy advisory shown above Submit when zone = 119. -->
    <string name="goto_outer_island_advisory">Outer-island accuracy: ±10–20 m vs the official 7-parameter datum shift.</string>

