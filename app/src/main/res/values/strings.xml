    <string name="goto_autofill_hint_outside_taiwan">Outside Taiwan coverage.</string>
    <string name="goto_autofill_hint_taipower_outer_island">Taipower does not cover outer islands.</string>

    <!-- Recent entries section. -->
    <string name="goto_recent_header">Recent</string>
    <string name="goto_recent_empty">No recent entries.</string>
    <string name="goto_recent_delete">Remove</string>

    <!-- Settings-page button (FR-016 second entry point). -->
    <string name="pref_open_goto_title">Open Coordinate Input</string>
    <string name="pref_open_goto_summary">Type a Taipower / TWD97 / TWD67 coordinate and pan the map there.</string>

