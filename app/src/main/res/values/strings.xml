    <!-- Widget row labels. -->
    <string name="label_map">MAP</string>
    <string name="label_me">ME</string>
    <string name="label_target">TGT</string>

    <!-- Coordinate-unit tags shown on each row. -->
    <string name="unit_tag_taipower">TPC</string>
    <string name="unit_tag_twd97">TWD97</string>
    <string name="unit_tag_twd67">TWD67</string>

    <!-- Readout state messages. -->
    <string name="state_out_of_range">out of range</string>
    <string name="state_no_fix">no fix</string>
    <string name="state_no_permission">no permission</string>

    <!-- Clipboard confirmation toast. -->
    <string name="toast_copied">Coordinate copied</string>
    <string name="toast_widget_hidden">TW Coordinates: off</string>
    <!-- %1$s is the localised unit tag (台電 / TWD97 / TWD67) — auto-filled by code. -->
