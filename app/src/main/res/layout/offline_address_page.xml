<?xml version="1.0" encoding="utf-8"?>
<!--
  Feature 008 — OfflineAddressReceiver page (replaces the feature 005/007 layout).
  New vs. before: a "total usage + stacked bar + legend" block at the top of
  State B
    - offline_address_usage_total : e.g. "498.9 MB on disk" (filled by the
      receiver; includes the boundary layer)
    - offline_address_usage_bar   : horizontal LinearLayout; the receiver adds
      weighted colour segments per county / boundary
    - offline_address_usage_legend: horizontal LinearLayout; the receiver adds
      "colour dot + county + size"
  The progress and error rows become cards (progress bar / red banner). State A,
  the per-county list container, Import, legacy table, and the boundary row are
  otherwise unchanged. Pure Android widgets (ADR-0009 D6).
-->
<!-- Constitution III "Scrollable by default": the whole page is wrapped in a single
     outer ScrollView so a long county list can never push the Import button (or the
     boundary row) off the bottom edge. The per-county list is a plain LinearLayout
     (no inner vertical scroller — nested vertical scrollers are forbidden). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1B1B1B"
    android:fillViewport="true">

<LinearLayout
    android:id="@+id/offline_address_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/offline_address_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/offline_address_page_title"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:paddingBottom="8dp" />

    <!-- Import-in-progress card: title + progress bar + % text (replaces the old
         plain progress row). The receiver toggles _card visibility and sets the
         _bar to determinate/indeterminate per stage. -->
    <LinearLayout
        android:id="@+id/offline_address_progress_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/oa_progress_card_bg"
        android:padding="13dp"
        android:layout_marginBottom="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/offline_address_progress_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:text="@string/offline_address_importing_label" />

        <ProgressBar
            android:id="@+id/offline_address_progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#33CCFF"
            android:indeterminateTint="#33CCFF" />

        <!-- Existing id retained; showProgress(text) keeps using it. -->
        <TextView
            android:id="@+id/offline_address_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#BFBFBF"
            android:textSize="13sp"
            android:textStyle="italic" />
    </LinearLayout>

    <!-- Import-failure red banner: warning glyph + title + reason + retry/dismiss
         (replaces the old plain error row). -->
    <LinearLayout
        android:id="@+id/offline_address_error_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/oa_error_card_bg"
        android:padding="13dp"
        android:layout_marginBottom="10dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:textSize="18sp"
                android:text="⚠" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FF8A80"
                android:textSize="15sp"
                android:textStyle="bold"
                android:text="@string/offline_address_error_title" />
        </LinearLayout>

        <!-- Existing id retained; showError(text) keeps using it (failure reason). -->
        <TextView
            android:id="@+id/offline_address_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#FFC9C4"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <Button
                android:id="@+id/offline_address_error_retry"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/offline_address_action_retry" />

            <Button
                android:id="@+id/offline_address_error_dismiss"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="@string/offline_address_action_dismiss" />
        </LinearLayout>
    </LinearLayout>

    <!-- State A — no dataset installed. -->
    <LinearLayout
        android:id="@+id/offline_address_state_a"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/offline_address_state_a_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#BFBFBF"
            android:text="@string/offline_address_empty_state"
            android:paddingBottom="12dp" />

        <Button
            android:id="@+id/offline_address_state_a_import"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/offline_address_button_import" />
    </LinearLayout>

    <!-- State B. -->
    <LinearLayout
        android:id="@+id/offline_address_state_b"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- ===== New in B: total usage + stacked bar + legend ===== -->
        <LinearLayout
            android:id="@+id/offline_address_usage_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/oa_usage_card_bg"
            android:padding="13dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/offline_address_usage_total"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Weighted colour segments added by the receiver. Height fixed;
                 each segment's weight is its byte count. -->
            <LinearLayout
                android:id="@+id/offline_address_usage_bar"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:background="@drawable/oa_usage_track_bg" />

            <!-- Legend wrapped in a horizontal scroller so many counties' entries stay readable
                 (scroll instead of being clipped off the right edge). -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/offline_address_usage_legend"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>

        <!-- Per-county list container (B row template inflated per county).
             Plain LinearLayout: the whole page scrolls via the outer ScrollView, so
             this must NOT be an inner vertical scroller (Constitution III). -->
        <LinearLayout
            android:id="@+id/offline_address_state_b_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/oa_usage_card_bg"
            android:paddingStart="12dp"
            android:paddingEnd="6dp" />

        <Button
            android:id="@+id/offline_address_state_b_import"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="@string/offline_address_button_import" />

        <!-- Legacy single-active table + actions (test-only; hidden in production). -->
        <TableLayout
            android:id="@+id/offline_address_state_b_legacy_table"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stretchColumns="1"
            android:visibility="gone">

            <TableRow>
                <TextView android:text="@string/offline_address_field_county" android:paddingRight="12dp" android:textColor="#BFBFBF" />
                <TextView android:id="@+id/offline_address_value_county" android:textColor="#FFFFFF" />
            </TableRow>
            <TableRow>
                <TextView android:text="@string/offline_address_field_data_date" android:paddingRight="12dp" android:textColor="#BFBFBF" />
                <TextView android:id="@+id/offline_address_value_data_date" android:textColor="#FFFFFF" />
            </TableRow>
            <TableRow>
                <TextView android:text="@string/offline_address_field_source" android:paddingRight="12dp" android:textColor="#BFBFBF" />
                <TextView android:id="@+id/offline_address_value_source" android:textColor="#FFFFFF" />
            </TableRow>
            <TableRow>
                <TextView android:text="@string/offline_address_field_rows" android:paddingRight="12dp" android:textColor="#BFBFBF" />
                <TextView android:id="@+id/offline_address_value_rows" android:textColor="#FFFFFF" />
            </TableRow>
            <TableRow>
                <TextView android:text="@string/offline_address_field_csv_sha" android:paddingRight="12dp" android:textColor="#BFBFBF" />
                <TextView android:id="@+id/offline_address_value_csv_sha" android:singleLine="false" android:ellipsize="middle" android:textColor="#FFFFFF" />
            </TableRow>
            <TableRow>
                <TextView android:text="@string/offline_address_field_imported_at" android:paddingRight="12dp" android:textColor="#BFBFBF" />
                <TextView android:id="@+id/offline_address_value_imported_at" android:textColor="#FFFFFF" />
            </TableRow>
            <TableRow>
                <TextView android:text="@string/offline_address_field_file_sha" android:paddingRight="12dp" android:textColor="#BFBFBF" />
                <TextView android:id="@+id/offline_address_value_file_sha" android:singleLine="false" android:ellipsize="middle" android:textColor="#FFFFFF" />
            </TableRow>
            <TableRow>
                <TextView android:text="@string/offline_address_field_rtree_built" android:paddingRight="12dp" android:textColor="#BFBFBF" />
                <TextView android:id="@+id/offline_address_value_rtree_built" android:textColor="#FFFFFF" />
            </TableRow>
        </TableLayout>

        <LinearLayout
            android:id="@+id/offline_address_state_b_legacy_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="16dp"
            android:visibility="gone">

            <Button
                android:id="@+id/offline_address_state_b_replace"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/offline_address_button_replace"
                android:layout_marginEnd="12dp" />

            <Button
                android:id="@+id/offline_address_state_b_remove"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/offline_address_button_remove" />
        </LinearLayout>
    </LinearLayout>

    <!-- Base data (township boundary); page-level, outside State A/B. renderBoundaryRow
         applies oa_boundary_block_bg (dashed frame) so it reads as a block rather than
         a debug text line. -->
    <TextView
        android:id="@+id/offline_address_boundary_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/oa_boundary_block_bg"
        android:padding="11dp"
        android:textColor="#BFBFBF"
        android:textSize="14sp"
        android:visibility="gone" />

</LinearLayout>
</ScrollView>
