<?xml version="1.0" encoding="utf-8"?>
<!--
    Read-only information row for the settings page. Title is amber to flag the row visually
    as an advisory (matches the EyeAlt accent colour used elsewhere); summary is the
    long-form explanation in lighter grey. The Preference framework writes into
    @android:id/title and @android:id/summary.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@android:id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFFFB300"
        android:textSize="15sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@android:id/summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#FFE0E0E0"
        android:textSize="13sp"
        android:lineSpacingExtra="2dp"/>

</LinearLayout>
