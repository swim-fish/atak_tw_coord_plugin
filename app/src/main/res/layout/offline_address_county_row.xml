<?xml version="1.0" encoding="utf-8"?>
<!--
  Feature 005 — per-county row template for the Offline Address page State B.
  One inflated copy per active county; the receiver populates the four
  TextViews + binds the two buttons (each click is wrapped per Constitution VI).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/offline_address_county_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/offline_address_county_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="2dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="8dp">

        <Button
            android:id="@+id/offline_address_county_replace"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="@string/offline_address_button_replace"/>

        <Button
            android:id="@+id/offline_address_county_remove"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/offline_address_button_remove"/>
    </LinearLayout>
</LinearLayout>
