<?xml version="1.0" encoding="utf-8"?>
<!--
  Feature 006 forward-search page — feature 008 "compact single-row" redesign.
  Key changes vs. the original layout:
    * District: the inline fs_district_list GridLayout is removed. Replaced by a
      [All | District] segmented RadioGroup plus one fs_btn_district button;
      tapping fs_btn_district (when District scope is selected) raises an
      AlertDialog containing the township GridLayout (built in code). Default
      scope is "All" -> once a county is chosen the operator can search a street
      immediately.
    * House number: the inline fs_house_value + fs_keypad GridLayout are removed.
      Replaced by a single fs_house_field button that raises a numeric-keypad
      AlertDialog (built in code).
    * Everything else (county source, street, ordering, results, GoTo) is
      unchanged; the ids are unchanged.
  Still single-column, large targets (>=48dp, primary 56dp+), tap-only, GoTo
  only after a candidate is tapped.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#1B1B1B"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Empty-state: boundary data absent (FR-017 of feature 006). -->
        <TextView
            android:id="@+id/fs_boundary_missing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:visibility="gone"
            android:text="@string/fs_boundary_missing" />

        <!-- ===== Stage 1: county (label + Reset) ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:text="@string/fs_stage_county" />

            <Button
                android:id="@+id/fs_btn_reset"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:textSize="14sp"
                android:text="@string/fs_reset" />
        </LinearLayout>

        <TextView
            android:id="@+id/fs_county_chip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:background="?android:attr/selectableItemBackground"
            android:text="@string/fs_county_none" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3">

            <Button
                android:id="@+id/fs_btn_self"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:textSize="15sp"
                android:text="@string/fs_source_self" />

            <Button
                android:id="@+id/fs_btn_mapcenter"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:textSize="15sp"
                android:text="@string/fs_source_mapcenter" />

            <Button
                android:id="@+id/fs_btn_list"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:textSize="15sp"
                android:text="@string/fs_source_list" />
        </LinearLayout>

        <!-- The county list is now an on-demand AlertDialog (showCountyList), like the district
             chooser — no inline grid here. -->

        <!-- ===== Stage 2: district — segmented All/District + popup button ===== -->
        <TextView
            android:id="@+id/fs_stage_district_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:paddingBottom="4dp"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="#FFFFFF"
            android:visibility="gone"
            android:text="@string/fs_stage_district" />

        <!-- One row: [All | District] segmented (RadioGroup) + district picker button. -->
        <LinearLayout
            android:id="@+id/fs_scope_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <RadioGroup
                android:id="@+id/fs_scope_group"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/fs_scope_all"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:minWidth="76dp"
                    android:button="@null"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:background="@drawable/fs_grid_cell_bg"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:text="@string/fs_scope_all"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/fs_scope_specific"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:minWidth="88dp"
                    android:button="@null"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/fs_grid_cell_bg"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:text="@string/fs_scope_specific" />
            </RadioGroup>

            <!-- Opens the district AlertDialog. Disabled while All is selected. -->
            <Button
                android:id="@+id/fs_btn_district"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:textSize="15sp"
                android:enabled="false"
                android:text="@string/fs_district_whole_county" />
        </LinearLayout>

        <!-- ===== Stage 3: street ===== -->
        <TextView
            android:id="@+id/fs_stage_street_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:paddingBottom="4dp"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="#FFFFFF"
            android:visibility="gone"
            android:text="@string/fs_stage_street" />

        <LinearLayout
            android:id="@+id/fs_street_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <EditText
                android:id="@+id/fs_street_input"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:inputType="text"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:textColorHint="#7C7C7C"
                android:hint="@string/fs_street_hint"
                android:importantForAutofill="no" />

            <Button
                android:id="@+id/fs_btn_search"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:textSize="15sp"
                android:text="@string/fs_search" />
        </LinearLayout>

        <!-- ===== Stage 4: house number — opens numeric-keypad AlertDialog ===== -->
        <Button
            android:id="@+id/fs_house_field"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:textSize="16sp"
            android:gravity="start|center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:visibility="gone"
            android:text="@string/fs_house_hint" />

        <!-- ===== Result ordering (feature 007 US1): most-similar / distance ===== -->
        <LinearLayout
            android:id="@+id/fs_ordering_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="8dp"
            android:visibility="gone"
            android:weightSum="3">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:text="@string/fs_ordering_label" />

            <Button
                android:id="@+id/fs_btn_order_similar"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:textSize="14sp"
                android:text="@string/fs_ordering_similar" />

            <Button
                android:id="@+id/fs_btn_order_distance"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:textSize="14sp"
                android:text="@string/fs_ordering_distance" />
        </LinearLayout>

        <!-- ===== Candidate list + GoTo ===== -->
        <TextView
            android:id="@+id/fs_empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:textSize="15sp"
            android:textColor="#FFFFFF"
            android:visibility="gone"
            android:text="@string/fs_no_match" />

        <LinearLayout
            android:id="@+id/fs_candidate_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/fs_btn_goto"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="8dp"
            android:textSize="18sp"
            android:textStyle="bold"
            android:enabled="false"
            android:visibility="gone"
            android:text="@string/fs_goto" />
    </LinearLayout>
</ScrollView>
