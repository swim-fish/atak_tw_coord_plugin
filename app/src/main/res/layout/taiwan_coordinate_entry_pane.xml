<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/native_entry_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:scrollbars="vertical">

    <LinearLayout
        android:id="@+id/native_entry_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <RadioGroup
            android:id="@+id/native_entry_system_group"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/native_entry_segment_track"
            android:contentDescription="@string/native_entry_a11y_system_selector"
            android:orientation="horizontal"
            android:padding="3dp">

            <RadioButton
                android:id="@+id/native_entry_system_taipower"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/native_entry_segment_option"
                android:button="@null"
                android:checked="true"
                android:gravity="center"
                android:text="@string/native_entry_system_taipower"
                android:textColor="@color/native_entry_segment_text"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/native_entry_system_twd97"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/native_entry_segment_option"
                android:button="@null"
                android:enabled="true"
                android:gravity="center"
                android:text="@string/native_entry_system_twd97"
                android:textColor="@color/native_entry_segment_text"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/native_entry_system_twd67"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/native_entry_segment_option"
                android:button="@null"
                android:enabled="true"
                android:gravity="center"
                android:text="@string/native_entry_system_twd67"
                android:textColor="@color/native_entry_segment_text"
                android:textSize="16sp" />
        </RadioGroup>

        <LinearLayout
            android:id="@+id/native_entry_pane_taipower"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:labelFor="@id/native_entry_input_taipower"
                android:text="@string/native_entry_system_taipower"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/native_entry_input_taipower"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:autofillHints=""
                android:background="@drawable/native_entry_input_bg"
                android:contentDescription="@string/native_entry_a11y_taipower_input"
                android:hint="@string/native_entry_taipower_hint"
                android:imeOptions="actionDone"
                android:inputType="textCapCharacters|textNoSuggestions"
                android:maxLines="1"
                android:paddingStart="14dp"
                android:paddingTop="14dp"
                android:paddingEnd="14dp"
                android:paddingBottom="14dp"
                android:textColor="#FFFFFFFF"
                android:textColorHint="#99FFFFFF"
                android:textSize="20sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/native_entry_taipower_help"
                android:textColor="#B3FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/native_entry_pane_twd97"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:labelFor="@id/native_entry_twd97_easting"
                android:text="@string/native_entry_easting"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/native_entry_twd97_easting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:autofillHints=""
                android:background="@drawable/native_entry_input_bg"
                android:contentDescription="@string/native_entry_a11y_twd97_easting"
                android:inputType="number"
                android:maxLines="1"
                android:paddingStart="13dp"
                android:paddingTop="13dp"
                android:paddingEnd="13dp"
                android:paddingBottom="13dp"
                android:textColor="#FFFFFFFF"
                android:textSize="20sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:labelFor="@id/native_entry_twd97_northing"
                android:text="@string/native_entry_northing"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/native_entry_twd97_northing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:autofillHints=""
                android:background="@drawable/native_entry_input_bg"
                android:contentDescription="@string/native_entry_a11y_twd97_northing"
                android:inputType="number"
                android:maxLines="1"
                android:paddingStart="13dp"
                android:paddingTop="13dp"
                android:paddingEnd="13dp"
                android:paddingBottom="13dp"
                android:textColor="#FFFFFFFF"
                android:textSize="20sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/native_entry_zone"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp" />

            <RadioGroup
                android:id="@+id/native_entry_twd97_zone_group"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/native_entry_segment_track"
                android:contentDescription="@string/native_entry_a11y_twd97_zone"
                android:orientation="horizontal"
                android:padding="3dp">

                <RadioButton
                    android:id="@+id/native_entry_twd97_zone_121"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/native_entry_segment_option"
                    android:button="@null"
                    android:checked="true"
                    android:gravity="center"
                    android:text="@string/native_entry_zone_121"
                    android:textColor="@color/native_entry_segment_text"
                    android:textSize="16sp" />

                <RadioButton
                    android:id="@+id/native_entry_twd97_zone_119"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/native_entry_segment_option"
                    android:button="@null"
                    android:gravity="center"
                    android:text="@string/native_entry_zone_119"
                    android:textColor="@color/native_entry_segment_text"
                    android:textSize="16sp" />
            </RadioGroup>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/native_entry_pane_twd67"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:labelFor="@id/native_entry_twd67_easting"
                android:text="@string/native_entry_easting"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/native_entry_twd67_easting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:autofillHints=""
                android:background="@drawable/native_entry_input_bg"
                android:contentDescription="@string/native_entry_a11y_twd67_easting"
                android:inputType="number"
                android:maxLines="1"
                android:paddingStart="13dp"
                android:paddingTop="13dp"
                android:paddingEnd="13dp"
                android:paddingBottom="13dp"
                android:textColor="#FFFFFFFF"
                android:textSize="20sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:labelFor="@id/native_entry_twd67_northing"
                android:text="@string/native_entry_northing"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/native_entry_twd67_northing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:autofillHints=""
                android:background="@drawable/native_entry_input_bg"
                android:contentDescription="@string/native_entry_a11y_twd67_northing"
                android:inputType="number"
                android:maxLines="1"
                android:paddingStart="13dp"
                android:paddingTop="13dp"
                android:paddingEnd="13dp"
                android:paddingBottom="13dp"
                android:textColor="#FFFFFFFF"
                android:textSize="20sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/native_entry_zone"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp" />

            <RadioGroup
                android:id="@+id/native_entry_twd67_zone_group"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/native_entry_segment_track"
                android:contentDescription="@string/native_entry_a11y_twd67_zone"
                android:orientation="horizontal"
                android:padding="3dp">

                <RadioButton
                    android:id="@+id/native_entry_twd67_zone_121"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/native_entry_segment_option"
                    android:button="@null"
                    android:checked="true"
                    android:gravity="center"
                    android:text="@string/native_entry_zone_121"
                    android:textColor="@color/native_entry_segment_text"
                    android:textSize="16sp" />

                <RadioButton
                    android:id="@+id/native_entry_twd67_zone_119"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/native_entry_segment_option"
                    android:button="@null"
                    android:gravity="center"
                    android:text="@string/native_entry_zone_119"
                    android:textColor="@color/native_entry_segment_text"
                    android:textSize="16sp" />
            </RadioGroup>

            <TextView
                android:id="@+id/native_entry_twd67_advisory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/native_entry_advisory_bg"
                android:padding="10dp"
                android:text="@string/native_entry_outer_island_advisory"
                android:textColor="#FFFFD699"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/native_entry_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:accessibilityLiveRegion="polite"
            android:contentDescription="@string/native_entry_a11y_status"
            android:minHeight="24dp"
            android:textColor="#FFFFB34D"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
