<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/native_entry_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="false"
    android:scrollbars="vertical">

    <LinearLayout
        android:id="@+id/native_entry_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="2dp">

        <RadioGroup
            android:id="@+id/native_entry_system_group"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/native_entry_segment_track"
            android:contentDescription="@string/native_entry_a11y_system_selector"
            android:orientation="horizontal"
            android:paddingStart="2dp"
            android:paddingEnd="2dp">

            <RadioButton
                android:id="@+id/native_entry_system_taipower"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/native_entry_segment_option"
                android:button="@null"
                android:checked="true"
                android:gravity="center"
                android:text="@string/native_entry_system_taipower"
                android:textColor="@color/native_entry_segment_text"
                android:textSize="@dimen/native_entry_title_font" />

            <RadioButton
                android:id="@+id/native_entry_system_twd97"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/native_entry_segment_option"
                android:button="@null"
                android:enabled="true"
                android:gravity="center"
                android:text="@string/native_entry_system_twd97"
                android:textColor="@color/native_entry_segment_text"
                android:textSize="@dimen/native_entry_title_font" />

            <RadioButton
                android:id="@+id/native_entry_system_twd67"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/native_entry_segment_option"
                android:button="@null"
                android:enabled="true"
                android:gravity="center"
                android:text="@string/native_entry_system_twd67"
                android:textColor="@color/native_entry_segment_text"
                android:textSize="@dimen/native_entry_title_font" />

            <RadioButton
                android:id="@+id/native_entry_system_address"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/native_entry_segment_option"
                android:button="@null"
                android:gravity="center"
                android:text="@string/native_entry_system_address"
                android:textColor="@color/native_entry_segment_text"
                android:textSize="@dimen/native_entry_title_font" />
        </RadioGroup>

        <LinearLayout
            android:id="@+id/native_entry_pane_taipower"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/native_entry_taipower_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:weightSum="10">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="3"
                    android:gravity="center"
                    android:labelFor="@id/native_entry_input_taipower"
                    android:text="@string/native_entry_system_taipower"
                    android:textColor="#FFFFFFFF"
                    android:textSize="@dimen/native_entry_title_font" />

                <EditText
                    android:id="@+id/native_entry_input_taipower"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="7"
                    android:autofillHints=""
                    android:contentDescription="@string/native_entry_a11y_taipower_input"
                    android:hint="@string/native_entry_taipower_hint"
                    android:imeOptions="actionDone"
                    android:inputType="textCapCharacters|textNoSuggestions"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textColor="#FFFFFFFF"
                    android:textColorHint="#99FFFFFF"
                    android:textSize="@dimen/native_entry_title_font" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="10">

                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="3" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="7"
                    android:text="@string/native_entry_taipower_help"
                    android:textColor="#B3FFFFFF"
                    android:textSize="@dimen/native_entry_help_font" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/native_entry_pane_twd97"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:weightSum="10">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="3"
                    android:gravity="center"
                    android:labelFor="@id/native_entry_twd97_easting"
                    android:text="@string/native_entry_easting"
                    android:textColor="#FFFFFFFF"
                    android:textSize="@dimen/native_entry_title_font" />

                <EditText
                    android:id="@+id/native_entry_twd97_easting"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="6.5"
                    android:autofillHints=""
                    android:contentDescription="@string/native_entry_a11y_twd97_easting"
                    android:inputType="number"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textColor="#FFFFFFFF"
                    android:textSize="@dimen/native_entry_title_font" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.5"
                    android:text="@string/native_entry_metres_short"
                    android:textColor="#FFFFFFFF"
                    android:textSize="@dimen/native_entry_title_font" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:weightSum="10">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="3"
                    android:gravity="center"
                    android:labelFor="@id/native_entry_twd97_northing"
                    android:text="@string/native_entry_northing"
                    android:textColor="#FFFFFFFF"
                    android:textSize="@dimen/native_entry_title_font" />

                <EditText
                    android:id="@+id/native_entry_twd97_northing"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="6.5"
                    android:autofillHints=""
                    android:contentDescription="@string/native_entry_a11y_twd97_northing"
                    android:inputType="number"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textColor="#FFFFFFFF"
                    android:textSize="@dimen/native_entry_title_font" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.5"
                    android:text="@string/native_entry_metres_short"
                    android:textColor="#FFFFFFFF"
                    android:textSize="@dimen/native_entry_title_font" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:weightSum="10">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="3"
                    android:gravity="center"
                    android:text="@string/native_entry_zone"
                    android:textColor="#FFFFFFFF"
                    android:textSize="@dimen/native_entry_title_font" />

                <RadioGroup
                    android:id="@+id/native_entry_twd97_zone_group"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="7"
                    android:background="@drawable/native_entry_segment_track"
                    android:contentDescription="@string/native_entry_a11y_twd97_zone"
                    android:orientation="horizontal"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp">

                    <RadioButton
                        android:id="@+id/native_entry_twd97_zone_121"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/native_entry_segment_option"
                        android:button="@null"
                        android:checked="true"
                        android:gravity="center"
                        android:text="@string/native_entry_zone_121"
                        android:textColor="@color/native_entry_segment_text"
                        android:textSize="@dimen/native_entry_title_font" />

                    <RadioButton
                        android:id="@+id/native_entry_twd97_zone_119"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/native_entry_segment_option"
                        android:button="@null"
                        android:gravity="center"
                        android:text="@string/native_entry_zone_119"
                        android:textColor="@color/native_entry_segment_text"
                        android:textSize="@dimen/native_entry_title_font" />
                </RadioGroup>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/native_entry_pane_twd67"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:weightSum="10">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="3"
                    android:gravity="center"
                    android:labelFor="@id/native_entry_twd67_easting"
                    android:text="@string/native_entry_easting"
                    android:textColor="#FFFFFFFF"
                    android:textSize="@dimen/native_entry_title_font" />

                <EditText
                    android:id="@+id/native_entry_twd67_easting"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="6.5"
                    android:autofillHints=""
                    android:contentDescription="@string/native_entry_a11y_twd67_easting"
                    android:inputType="number"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textColor="#FFFFFFFF"
                    android:textSize="@dimen/native_entry_title_font" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.5"
                    android:text="@string/native_entry_metres_short"
                    android:textColor="#FFFFFFFF"
                    android:textSize="@dimen/native_entry_title_font" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:weightSum="10">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="3"
                    android:gravity="center"
                    android:labelFor="@id/native_entry_twd67_northing"
                    android:text="@string/native_entry_northing"
                    android:textColor="#FFFFFFFF"
                    android:textSize="@dimen/native_entry_title_font" />

                <EditText
                    android:id="@+id/native_entry_twd67_northing"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="6.5"
                    android:autofillHints=""
                    android:contentDescription="@string/native_entry_a11y_twd67_northing"
                    android:inputType="number"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textColor="#FFFFFFFF"
                    android:textSize="@dimen/native_entry_title_font" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.5"
                    android:text="@string/native_entry_metres_short"
                    android:textColor="#FFFFFFFF"
                    android:textSize="@dimen/native_entry_title_font" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:weightSum="10">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="3"
                    android:gravity="center"
                    android:text="@string/native_entry_zone"
                    android:textColor="#FFFFFFFF"
                    android:textSize="@dimen/native_entry_title_font" />

                <RadioGroup
                    android:id="@+id/native_entry_twd67_zone_group"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="7"
                    android:background="@drawable/native_entry_segment_track"
                    android:contentDescription="@string/native_entry_a11y_twd67_zone"
                    android:orientation="horizontal"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp">

                    <RadioButton
                        android:id="@+id/native_entry_twd67_zone_121"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/native_entry_segment_option"
                        android:button="@null"
                        android:checked="true"
                        android:gravity="center"
                        android:text="@string/native_entry_zone_121"
                        android:textColor="@color/native_entry_segment_text"
                        android:textSize="@dimen/native_entry_title_font" />

                    <RadioButton
                        android:id="@+id/native_entry_twd67_zone_119"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/native_entry_segment_option"
                        android:button="@null"
                        android:gravity="center"
                        android:text="@string/native_entry_zone_119"
                        android:textColor="@color/native_entry_segment_text"
                        android:textSize="@dimen/native_entry_title_font" />
                </RadioGroup>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="10">

                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="3" />

                <TextView
                    android:id="@+id/native_entry_twd67_advisory"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="7"
                    android:background="@drawable/native_entry_advisory_bg"
                    android:padding="4dp"
                    android:text="@string/native_entry_outer_island_advisory"
                    android:textColor="#FFFFD699"
                    android:textSize="@dimen/native_entry_help_font"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/native_entry_pane_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/native_entry_address_full_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:weightSum="10">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="3"
                    android:gravity="center"
                    android:labelFor="@id/native_entry_address_full"
                    android:text="@string/native_entry_address_full_label"
                    android:textColor="#FFFFFFFF"
                    android:textSize="@dimen/native_entry_title_font" />

                <EditText
                    android:id="@+id/native_entry_address_full"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="7"
                    android:autofillHints="postalAddress"
                    android:contentDescription="@string/native_entry_a11y_address_full"
                    android:hint="@string/native_entry_address_full_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="textPostalAddress|textNoSuggestions"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textColor="#FFFFFFFF"
                    android:textColorHint="#99FFFFFF"
                    android:textSize="@dimen/native_entry_title_font" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/native_entry_address_structured"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/native_entry_address_county_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:weightSum="10">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="3"
                        android:gravity="center"
                        android:labelFor="@id/native_entry_address_county"
                        android:text="@string/native_entry_address_county_label"
                        android:textColor="#FFFFFFFF"
                        android:textSize="@dimen/native_entry_title_font" />

                    <EditText
                        android:id="@+id/native_entry_address_county"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="7"
                        android:autofillHints="postalAddressRegion"
                        android:contentDescription="@string/native_entry_a11y_address_county"
                        android:hint="@string/native_entry_address_county_hint"
                        android:inputType="textPostalAddress|textNoSuggestions"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textColor="#FFFFFFFF"
                        android:textColorHint="#99FFFFFF"
                        android:textSize="@dimen/native_entry_title_font" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/native_entry_address_district_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:weightSum="10">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="3"
                        android:gravity="center"
                        android:labelFor="@id/native_entry_address_district"
                        android:text="@string/native_entry_address_district_label"
                        android:textColor="#FFFFFFFF"
                        android:textSize="@dimen/native_entry_title_font" />

                    <EditText
                        android:id="@+id/native_entry_address_district"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="7"
                        android:autofillHints="postalAddressLocality"
                        android:contentDescription="@string/native_entry_a11y_address_district"
                        android:hint="@string/native_entry_address_district_hint"
                        android:inputType="textPostalAddress|textNoSuggestions"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textColor="#FFFFFFFF"
                        android:textColorHint="#99FFFFFF"
                        android:textSize="@dimen/native_entry_title_font" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/native_entry_address_road_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:weightSum="10">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="3"
                        android:gravity="center"
                        android:labelFor="@id/native_entry_address_road"
                        android:text="@string/native_entry_address_road_label"
                        android:textColor="#FFFFFFFF"
                        android:textSize="@dimen/native_entry_title_font" />

                    <EditText
                        android:id="@+id/native_entry_address_road"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="7"
                        android:autofillHints="postalAddress"
                        android:contentDescription="@string/native_entry_a11y_address_road"
                        android:hint="@string/native_entry_address_road_hint"
                        android:inputType="textPostalAddress|textNoSuggestions"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textColor="#FFFFFFFF"
                        android:textColorHint="#99FFFFFF"
                        android:textSize="@dimen/native_entry_title_font" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/native_entry_address_tail_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:weightSum="10">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="3"
                        android:gravity="center"
                        android:labelFor="@id/native_entry_address_tail"
                        android:text="@string/native_entry_address_tail_label"
                        android:textColor="#FFFFFFFF"
                        android:textSize="@dimen/native_entry_title_font" />

                    <EditText
                        android:id="@+id/native_entry_address_tail"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="7"
                        android:autofillHints="postalAddress"
                        android:contentDescription="@string/native_entry_a11y_address_tail"
                        android:hint="@string/native_entry_address_tail_hint"
                        android:imeOptions="actionSearch"
                        android:inputType="textPostalAddress|textNoSuggestions"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textColor="#FFFFFFFF"
                        android:textColorHint="#99FFFFFF"
                        android:textSize="@dimen/native_entry_title_font" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end|center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/native_entry_address_mode"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/native_entry_control_min_size"
                    android:contentDescription="@string/native_entry_a11y_address_mode"
                    android:minHeight="@dimen/native_entry_control_min_size"
                    android:text="@string/native_entry_address_mode_structured"
                    android:textAllCaps="false"
                    android:textColor="@color/native_entry_action_text" />

                <Button
                    android:id="@+id/native_entry_address_choose"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/native_entry_control_min_size"
                    android:contentDescription="@string/native_entry_a11y_address_choose"
                    android:minHeight="@dimen/native_entry_control_min_size"
                    android:text="@string/native_entry_address_choose_result"
                    android:textAllCaps="false"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/native_entry_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:contentDescription="@string/native_entry_a11y_status"
            android:gravity="center_horizontal"
            android:textColor="#FFFFB34D"
            android:textSize="@dimen/native_entry_help_font"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
