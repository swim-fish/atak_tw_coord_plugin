<?xml version="1.0" encoding="utf-8"?>
<!--
  TW Coord GoTo input page.

  Layout strategy: avoid Fragments inside a DropDownReceiver. Instead, all
  three tab panes are inflated up-front as siblings of @id/goto_pane_root,
  and the controller flips View.GONE / View.VISIBLE per tab. This sidesteps
  the FragmentManager-from-plugin-context lifecycle gotchas the meshtastic
  sample documents (its DropDowns also avoid Fragments for the same reason).

  Tab pane content is filled in per user story:
  - Taipower pane (T024 / T025, US1)
  - TWD97 / TWD67 panes (T038 / T039, US2)
  - Auto Fill button overlay (T060, US5)
  - Recent section (T076, US4)
-->
<!--
  Outer ScrollView so the page is scrollable on short screens — without it,
  on phones the marker-mode grid + Submit + ATAK-picker button + Recent
  section get clipped below the fold and the operator cannot reach them.
  The dark background lives on the ScrollView so it fills the whole pane;
  padding stays on the inner LinearLayout so the scrollbar tracks the
  outer edge.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1B1B1B"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/goto_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

    <TextView
        android:id="@+id/goto_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/goto_title"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:paddingBottom="8dp"/>

    <!-- Simple radio-group tab bar (no TabLayout dependency — keeps the layout
         agnostic of androidx.material). Selecting a radio shows the matching
         pane below. -->
    <RadioGroup
        android:id="@+id/goto_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <RadioButton
            android:id="@+id/goto_tab_taipower"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/goto_tab_taipower"
            android:textColor="#FFFFFF"
            android:button="@null"
            android:gravity="center"
            android:background="?android:attr/selectableItemBackground"
            android:padding="8dp"
            android:checked="true"/>

        <RadioButton
            android:id="@+id/goto_tab_twd97"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/goto_tab_twd97"
            android:textColor="#BFBFBF"
            android:button="@null"
            android:gravity="center"
            android:background="?android:attr/selectableItemBackground"
            android:padding="8dp"/>

        <RadioButton
            android:id="@+id/goto_tab_twd67"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/goto_tab_twd67"
            android:textColor="#BFBFBF"
            android:button="@null"
            android:gravity="center"
            android:background="?android:attr/selectableItemBackground"
            android:padding="8dp"/>
    </RadioGroup>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2E2E2E"
        android:layout_marginBottom="8dp"/>

    <!-- Taipower pane (US1) -->
    <LinearLayout
        android:id="@+id/goto_pane_taipower"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="visible">

        <Button
            android:id="@+id/goto_autofill_taipower"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginBottom="4dp"
            android:minHeight="0dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textSize="12sp"
            android:text="@string/goto_btn_autofill"/>

        <EditText
            android:id="@+id/goto_input_taipower"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/goto_hint_taipower"
            android:textColor="#FFFFFF"
            android:textColorHint="#7C7C7C"
            android:textSize="16sp"
            android:inputType="textCapCharacters"
            android:maxLines="1"
            android:imeOptions="actionGo"
            android:backgroundTint="#FFFFFF"
            android:autofillHints="postalAddress"/>

        <TextView
            android:id="@+id/goto_error_taipower"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FF8A80"
            android:textSize="13sp"
            android:paddingTop="4dp"
            android:visibility="gone"/>
    </LinearLayout>

    <!-- TWD97 pane (US2). -->
    <LinearLayout
        android:id="@+id/goto_pane_twd97"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <Button
            android:id="@+id/goto_autofill_twd97"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginBottom="4dp"
            android:minHeight="0dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textSize="12sp"
            android:text="@string/goto_btn_autofill"/>

        <!-- Easting + Northing on a single horizontal row to save vertical space. Each takes
             half the pane width via layout_weight; a 6dp spacer between keeps them visually
             distinct. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/goto_input_twd97_easting"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/goto_hint_easting"
                android:textColor="#FFFFFF"
                android:textColorHint="#7C7C7C"
                android:textSize="16sp"
                android:inputType="number"
                android:maxLines="1"
                android:backgroundTint="#FFFFFF"
                android:autofillHints="postalAddress"/>

            <Space
                android:layout_width="6dp"
                android:layout_height="wrap_content"/>

            <EditText
                android:id="@+id/goto_input_twd97_northing"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/goto_hint_northing"
                android:textColor="#FFFFFF"
                android:textColorHint="#7C7C7C"
                android:textSize="16sp"
                android:inputType="number"
                android:maxLines="1"
                android:backgroundTint="#FFFFFF"
                android:autofillHints="postalAddress"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/goto_zone_label"
            android:textColor="#BFBFBF"
            android:textSize="13sp"/>

        <RadioGroup
            android:id="@+id/goto_zone_twd97"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <RadioButton
                android:id="@+id/goto_zone_twd97_121"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/goto_zone_121"
                android:textColor="#FFFFFF"
                android:checked="true"/>
            <RadioButton
                android:id="@+id/goto_zone_twd97_119"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/goto_zone_119"
                android:textColor="#FFFFFF"/>
        </RadioGroup>

        <TextView
            android:id="@+id/goto_advisory_twd97"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/goto_outer_island_advisory"
            android:textColor="#FFB74D"
            android:textSize="12sp"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/goto_error_twd97"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FF8A80"
            android:textSize="13sp"
            android:paddingTop="4dp"
            android:visibility="gone"/>
    </LinearLayout>

    <!-- TWD67 pane (US2). -->
    <LinearLayout
        android:id="@+id/goto_pane_twd67"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <Button
            android:id="@+id/goto_autofill_twd67"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginBottom="4dp"
            android:minHeight="0dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textSize="12sp"
            android:text="@string/goto_btn_autofill"/>

        <!-- Easting + Northing on a single horizontal row (same compaction as TWD97 above). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/goto_input_twd67_easting"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/goto_hint_easting"
                android:textColor="#FFFFFF"
                android:textColorHint="#7C7C7C"
                android:textSize="16sp"
                android:inputType="number"
                android:maxLines="1"
                android:backgroundTint="#FFFFFF"
                android:autofillHints="postalAddress"/>

            <Space
                android:layout_width="6dp"
                android:layout_height="wrap_content"/>

            <EditText
                android:id="@+id/goto_input_twd67_northing"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/goto_hint_northing"
                android:textColor="#FFFFFF"
                android:textColorHint="#7C7C7C"
                android:textSize="16sp"
                android:inputType="number"
                android:maxLines="1"
                android:backgroundTint="#FFFFFF"
                android:autofillHints="postalAddress"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/goto_zone_label"
            android:textColor="#BFBFBF"
            android:textSize="13sp"/>

        <RadioGroup
            android:id="@+id/goto_zone_twd67"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <RadioButton
                android:id="@+id/goto_zone_twd67_121"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/goto_zone_121"
                android:textColor="#FFFFFF"
                android:checked="true"/>
            <RadioButton
                android:id="@+id/goto_zone_twd67_119"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/goto_zone_119"
                android:textColor="#FFFFFF"/>
        </RadioGroup>

        <TextView
            android:id="@+id/goto_advisory_twd67"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/goto_outer_island_advisory"
            android:textColor="#FFB74D"
            android:textSize="12sp"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/goto_error_twd67"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FF8A80"
            android:textSize="13sp"
            android:paddingTop="4dp"
            android:visibility="gone"/>
    </LinearLayout>

    <!-- Marker-drop mode picker (8 options laid out 4×2). Manual mutual exclusion is
         enforced in TwCoordGotoView.applyMarkerModeUI because Android RadioGroup only
         scopes its mutual exclusion to direct child RadioButtons — splitting into 2 rows
         loses that scope, so the controller handles it. Default = Move only. -->
    <TextView
        android:id="@+id/goto_marker_mode_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/goto_marker_mode_header"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="2dp">
        <RadioButton
            android:id="@+id/goto_mode_move"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/goto_mode_move"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:button="@null"
            android:drawableTop="@drawable/ic_marker_move"
            android:drawablePadding="2dp"
            android:gravity="center"
            android:padding="4dp"
            android:checked="true"/>
        <RadioButton
            android:id="@+id/goto_mode_waypoint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/goto_mode_waypoint"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:button="@null"
            android:drawableTop="@drawable/ic_marker_waypoint"
            android:drawablePadding="2dp"
            android:gravity="center"
            android:padding="4dp"/>
        <RadioButton
            android:id="@+id/goto_mode_mission"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/goto_mode_mission"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:button="@null"
            android:drawableTop="@drawable/ic_marker_mission"
            android:drawablePadding="2dp"
            android:gravity="center"
            android:padding="4dp"/>
        <RadioButton
            android:id="@+id/goto_mode_spi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/goto_mode_spi"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:button="@null"
            android:drawableTop="@drawable/ic_marker_spi"
            android:drawablePadding="2dp"
            android:gravity="center"
            android:padding="4dp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="2dp">
        <RadioButton
            android:id="@+id/goto_mode_friendly"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/goto_mode_friendly"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:button="@null"
            android:drawableTop="@drawable/ic_marker_friendly"
            android:drawablePadding="2dp"
            android:gravity="center"
            android:padding="4dp"/>
        <RadioButton
            android:id="@+id/goto_mode_hostile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/goto_mode_hostile"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:button="@null"
            android:drawableTop="@drawable/ic_marker_hostile"
            android:drawablePadding="2dp"
            android:gravity="center"
            android:padding="4dp"/>
        <RadioButton
            android:id="@+id/goto_mode_neutral"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/goto_mode_neutral"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:button="@null"
            android:drawableTop="@drawable/ic_marker_neutral"
            android:drawablePadding="2dp"
            android:gravity="center"
            android:padding="4dp"/>
        <RadioButton
            android:id="@+id/goto_mode_unknown"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/goto_mode_unknown"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:button="@null"
            android:drawableTop="@drawable/ic_marker_unknown"
            android:drawablePadding="2dp"
            android:gravity="center"
            android:padding="4dp"/>
    </LinearLayout>

    <!-- Submit button shared by all tabs. Disabled until the active tab's
         input is in ParseResult.Ok state. Uses the selected marker-mode radio above. -->
    <Button
        android:id="@+id/goto_btn_submit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/goto_btn_submit"
        android:enabled="false"/>

    <!-- Feature 003 (Option B / ADR-0011 D8): "Open ATAK icon menu" sibling of Submit.
         Hands the parsed coordinate to ATAK's native EnterLocationDropDownReceiver, which
         drops a marker using whichever pallet/icon the operator already has selected in
         ATAK's own enter-location pane. The 8 marker-mode radios above do NOT gate this
         button — it always delegates to ATAK regardless of the radio selection. -->
    <Button
        android:id="@+id/goto_btn_atak_picker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/goto_btn_atak_picker"
        android:enabled="false"/>

    <!-- Recent entries section (US4). -->
    <LinearLayout
        android:id="@+id/goto_recent_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="16dp">

        <TextView
            android:id="@+id/goto_recent_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/goto_recent_header"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#2E2E2E"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/goto_recent_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/goto_recent_empty"
            android:textColor="#7C7C7C"
            android:textSize="13sp"
            android:padding="8dp"/>

        <LinearLayout
            android:id="@+id/goto_recent_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>
    </LinearLayout>

    </LinearLayout>
</ScrollView>
