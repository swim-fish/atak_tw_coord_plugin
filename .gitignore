# Build outputs
build/
dist/
.gradle/
out/
bin/
obj/

# Java / Kotlin
*.class
*.jar
*.war
*.ear
*.iml
*.tmp
*.log

# Python bytecode cache (scripts/check-tpp-exclusions.py imports the generator)
__pycache__/
*.pyc

# Exception: the Gradle wrapper jar MUST be committed so fresh clones
# (and TAK TPP's ephemeral build environment) can bootstrap ./gradlew.
# Without this, TPP fails with "Could not find or load main class
# org.gradle.wrapper.GradleWrapperMain".
!gradle/wrapper/gradle-wrapper.jar

# Android Studio / IntelliJ
.idea/
*.ipr
*.iws
captures/
local.properties

# OS junk
.DS_Store
Thumbs.db

# Editor swap
*.swp

# Plugin signing keystores live alongside the build but are NEVER committed
key.jks
*.keystore

# Generated proguard repackage instruction (rewritten on every build)
app/proguard-gradle-repackage.txt

# takdev-plugin temp dir (generated each build, git-status noise)
.takdev/

# ad-hoc on-device screenshots used during debugging
/*.png

# Manual acceptance log (per-run device data, sometimes contains location)
specs/**/acceptance-log.md
