<?xml version="1.0" encoding="utf-8"?>
<!-- 投影帶 121/119 segmented 格背景。state_checked = 青框青底；預設 = 淡框。
     mutual-exclusion 由 RadioGroup 自動處理，故僅靠 state_checked 即可正確上色。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="#4740A0D0"/>
            <stroke android:width="2dp" android:color="#33CCFF"/>
            <corners android:radius="7dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1AFFFFFF"/>
            <stroke android:width="1dp" android:color="#57FFFFFF"/>
            <corners android:radius="7dp"/>
        </shape>
    </item>
</selector>
