<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Fill 大鈕底（標題列「⊕ 帶入地圖中心」）。state_enabled=false 時轉灰，
     呼應 refreshAutoFillEnabled() 對 goto_autofill 的 setEnabled。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#0AFFFFFF"/>
            <stroke android:width="1.5dp" android:color="#1AFFFFFF"/>
            <corners android:radius="7dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1F33CCFF"/>
            <stroke android:width="1.5dp" android:color="#8C33CCFF"/>
            <corners android:radius="7dp"/>
        </shape>
    </item>
</selector>
