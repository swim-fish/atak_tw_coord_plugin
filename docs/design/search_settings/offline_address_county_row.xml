<?xml version="1.0" encoding="utf-8"?>
<!--
  B 案 — 每縣市「緊湊條列」row template（取代原 offline_address_county_row.xml）。
  改動：
    • 左側色條 offline_address_county_color（顏色由 receiver 依索引指定，對應頂部容量長條）。
    • 名稱 + 小字「資料日期 · 筆數」分兩行；容量移到右側獨立 TextView。
    • 原本 REPLACE / REMOVE 兩顆按鈕 → 收成一顆 ⋮ overflow（offline_address_county_overflow），
      receiver 用 PopupMenu 帶出「取代… / 移除」。
    • 底部 1dp 分隔線（最後一列由 receiver 隱藏）。
  純 Android widget（ADR-0009 D6）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <!-- per-county colour bar; background colour set in code -->
        <View
            android:id="@+id/offline_address_county_color"
            android:layout_width="4dp"
            android:layout_height="34dp"
            android:layout_marginEnd="10dp"
            android:background="#33CCFF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/offline_address_county_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

            <!-- 小字：資料日期 · 筆數（容量改放右側）。沿用既有 id 不變，語意改為 sub。 -->
            <TextView
                android:id="@+id/offline_address_county_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="1dp"
                android:textSize="12sp"
                android:textColor="#7C7C7C" />
        </LinearLayout>

        <TextView
            android:id="@+id/offline_address_county_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="2dp"
            android:textSize="15sp"
            android:textColor="#BFBFBF"
            android:singleLine="true" />

        <!-- ⋮ overflow → PopupMenu（取代… / 移除）。Button 用文字 ⋮，免額外 drawable 依賴。 -->
        <Button
            android:id="@+id/offline_address_county_overflow"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:textSize="22sp"
            android:textColor="#BFBFBF"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:text="⋮" />
    </LinearLayout>

    <!-- divider；最後一列 receiver 設為 GONE -->
    <View
        android:id="@+id/offline_address_county_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2E2E2E" />
</LinearLayout>
