<?xml version="1.0" encoding="utf-8"?>
<!--
  TW Coord GoTo 輸入頁 — V1「緊湊堆疊」重新設計（主案）。
  目標：在不動座標數學、不改 ParseResult / controller 的前提下，修掉六個痛點：
    ① 整頁太長 → 區塊收斂、分頁=segmented、欄位卡片化
    ② 兩顆送出鈕困惑 → 主「送出並前往」放大上色，次「改用 ATAK 圖示盤」做成 ghost
    ③ 標點 8 格太小 → 放大成 ≥72dp 手套友善格（drawableTop 圖示加大）
    ④ Auto Fill 太小又藏右上 → 升級成標題列「⊕ 帶入地圖中心」大鈕
    ⑤ 投影帶/外島不清 → 121/119 做成有說明的 segmented，119 即時顯示橘色精度提醒
    ⑥ 三系切換不一致 → 統一「分頁 → 欄位」語彙，台電/TWD 同一節奏

  ★ id 全數沿用原 tw_coord_goto.xml；唯一結構性改動：
    原本三個 per-pane 的 goto_autofill_taipower/_twd97/_twd67 合併為「單一」
    goto_autofill（放在標題列，依 activeTab 決定行為）。對應 Java 改動見
    TwCoordGotoView_changes.md §2。其餘 id（goto_tabs / goto_tab_* / goto_pane_* /
    goto_input_* / goto_zone_* / goto_advisory_* / goto_error_* / goto_marker_mode_* /
    goto_mode_* / goto_btn_submit / goto_btn_atak_picker / goto_recent_*）皆不變。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1B1B1B"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/goto_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- ===== 標題列：標題 + 單一 Auto Fill（痛點④）===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/goto_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/goto_title"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <!-- 合併後的單一 Auto Fill；onClick 依 activeTab 決定填哪一格、enable 依該帶可表示性。
                 disabled 原因走既有 Toast（onAutoFill 早退）或選配的 goto_autofill_hint。 -->
            <Button
                android:id="@+id/goto_autofill"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:minWidth="0dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#33CCFF"
                android:background="@drawable/goto_autofill_bg"
                android:text="@string/goto_btn_autofill"/>
        </LinearLayout>

        <!-- ===== 分頁列：segmented（痛點⑥）===== -->
        <!-- 容器圓角半透明；選取態由 styleTab() 以 goto_tab_selected 背景表現（button=@null）。 -->
        <RadioGroup
            android:id="@+id/goto_tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/goto_segment_track"
            android:padding="4dp"
            android:layout_marginBottom="12dp">

            <RadioButton
                android:id="@+id/goto_tab_taipower"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:button="@null"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:text="@string/goto_tab_taipower"
                android:checked="true"/>

            <RadioButton
                android:id="@+id/goto_tab_twd97"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:button="@null"
                android:gravity="center"
                android:textColor="#BFBFBF"
                android:textSize="16sp"
                android:text="@string/goto_tab_twd97"/>

            <RadioButton
                android:id="@+id/goto_tab_twd67"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:button="@null"
                android:gravity="center"
                android:textColor="#BFBFBF"
                android:textSize="16sp"
                android:text="@string/goto_tab_twd67"/>
        </RadioGroup>

        <!-- ===== 台電 pane（US1）===== -->
        <LinearLayout
            android:id="@+id/goto_pane_taipower"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <EditText
                android:id="@+id/goto_input_taipower"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/goto_input_bg"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:hint="@string/goto_hint_taipower"
                android:textColor="#FFFFFF"
                android:textColorHint="#7C7C7C"
                android:textSize="20sp"
                android:inputType="textCapCharacters"
                android:maxLines="1"
                android:imeOptions="actionGo"
                android:importantForAutofill="no"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:textColor="#7C7C7C"
                android:textSize="12sp"
                android:text="@string/goto_taipower_help"/>

            <TextView
                android:id="@+id/goto_error_taipower"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FF8A80"
                android:textSize="13sp"
                android:paddingTop="6dp"
                android:visibility="gone"/>
        </LinearLayout>

        <!-- ===== TWD97 pane（US2）===== -->
        <LinearLayout
            android:id="@+id/goto_pane_twd97"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/goto_input_twd97_easting"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/goto_input_bg"
                    android:padding="13dp"
                    android:hint="@string/goto_hint_easting"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#7C7C7C"
                    android:textSize="20sp"
                    android:inputType="number"
                    android:maxLines="1"
                    android:importantForAutofill="no"/>

                <Space android:layout_width="10dp" android:layout_height="wrap_content"/>

                <EditText
                    android:id="@+id/goto_input_twd97_northing"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/goto_input_bg"
                    android:padding="13dp"
                    android:hint="@string/goto_hint_northing"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#7C7C7C"
                    android:textSize="20sp"
                    android:inputType="number"
                    android:maxLines="1"
                    android:importantForAutofill="no"/>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/goto_zone_label"
                android:textColor="#BFBFBF"
                android:textSize="13sp"/>

            <!-- 投影帶 segmented（痛點⑤）；mutual-exclusion 由 RadioGroup 自動處理，
                 選取態由 goto_zone_cell_bg 的 state_checked 自動上色。 -->
            <RadioGroup
                android:id="@+id/goto_zone_twd97"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">
                <RadioButton
                    android:id="@+id/goto_zone_twd97_121"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:button="@null"
                    android:gravity="center"
                    android:background="@drawable/goto_zone_cell_bg"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:text="@string/goto_zone_121"
                    android:checked="true"/>
                <RadioButton
                    android:id="@+id/goto_zone_twd97_119"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:button="@null"
                    android:gravity="center"
                    android:background="@drawable/goto_zone_cell_bg"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:text="@string/goto_zone_119"/>
            </RadioGroup>

            <!-- 外島精度提醒；validateTwd97() 已依 zone==119 切 VISIBLE/GONE。 -->
            <TextView
                android:id="@+id/goto_advisory_twd97"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/goto_advisory_bg"
                android:padding="10dp"
                android:text="@string/goto_outer_island_advisory"
                android:textColor="#FFC97A"
                android:textSize="12sp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/goto_error_twd97"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FF8A80"
                android:textSize="13sp"
                android:paddingTop="6dp"
                android:visibility="gone"/>
        </LinearLayout>

        <!-- ===== TWD67 pane（US2）===== -->
        <LinearLayout
            android:id="@+id/goto_pane_twd67"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/goto_input_twd67_easting"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/goto_input_bg"
                    android:padding="13dp"
                    android:hint="@string/goto_hint_easting"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#7C7C7C"
                    android:textSize="20sp"
                    android:inputType="number"
                    android:maxLines="1"
                    android:importantForAutofill="no"/>

                <Space android:layout_width="10dp" android:layout_height="wrap_content"/>

                <EditText
                    android:id="@+id/goto_input_twd67_northing"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/goto_input_bg"
                    android:padding="13dp"
                    android:hint="@string/goto_hint_northing"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#7C7C7C"
                    android:textSize="20sp"
                    android:inputType="number"
                    android:maxLines="1"
                    android:importantForAutofill="no"/>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/goto_zone_label"
                android:textColor="#BFBFBF"
                android:textSize="13sp"/>

            <RadioGroup
                android:id="@+id/goto_zone_twd67"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">
                <RadioButton
                    android:id="@+id/goto_zone_twd67_121"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:button="@null"
                    android:gravity="center"
                    android:background="@drawable/goto_zone_cell_bg"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:text="@string/goto_zone_121"
                    android:checked="true"/>
                <RadioButton
                    android:id="@+id/goto_zone_twd67_119"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:button="@null"
                    android:gravity="center"
                    android:background="@drawable/goto_zone_cell_bg"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:text="@string/goto_zone_119"/>
            </RadioGroup>

            <TextView
                android:id="@+id/goto_advisory_twd67"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/goto_advisory_bg"
                android:padding="10dp"
                android:text="@string/goto_outer_island_advisory"
                android:textColor="#FFC97A"
                android:textSize="12sp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/goto_error_twd67"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FF8A80"
                android:textSize="13sp"
                android:paddingTop="6dp"
                android:visibility="gone"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#2E2E2E"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp"/>

        <!-- ===== 標點模式 8 格（4×2，放大成手套友善，痛點③）=====
             id 改名：goto_marker_mode_header 文案改「標點模式」（strings）。
             8 個 goto_mode_* id 不變；選取態由 goto_marker_cell_bg 的 state_checked
             自動上色，applyMarkerModeUI() 仍負責手動互斥（setChecked）。 -->
        <TextView
            android:id="@+id/goto_marker_mode_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/goto_marker_mode_header"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingBottom="6dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <RadioButton android:id="@+id/goto_mode_move"
                android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1"
                android:button="@null" android:gravity="center" android:textColor="#FFFFFF"
                android:textSize="13sp" android:drawableTop="@drawable/ic_marker_move"
                android:drawablePadding="5dp" android:background="@drawable/goto_marker_cell_bg"
                android:text="@string/goto_mode_move" android:checked="true"/>
            <Space android:layout_width="8dp" android:layout_height="wrap_content"/>
            <RadioButton android:id="@+id/goto_mode_waypoint"
                android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1"
                android:button="@null" android:gravity="center" android:textColor="#FFFFFF"
                android:textSize="13sp" android:drawableTop="@drawable/ic_marker_waypoint"
                android:drawablePadding="5dp" android:background="@drawable/goto_marker_cell_bg"
                android:text="@string/goto_mode_waypoint"/>
            <Space android:layout_width="8dp" android:layout_height="wrap_content"/>
            <RadioButton android:id="@+id/goto_mode_mission"
                android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1"
                android:button="@null" android:gravity="center" android:textColor="#FFFFFF"
                android:textSize="13sp" android:drawableTop="@drawable/ic_marker_mission"
                android:drawablePadding="5dp" android:background="@drawable/goto_marker_cell_bg"
                android:text="@string/goto_mode_mission"/>
            <Space android:layout_width="8dp" android:layout_height="wrap_content"/>
            <RadioButton android:id="@+id/goto_mode_spi"
                android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1"
                android:button="@null" android:gravity="center" android:textColor="#FFFFFF"
                android:textSize="13sp" android:drawableTop="@drawable/ic_marker_spi"
                android:drawablePadding="5dp" android:background="@drawable/goto_marker_cell_bg"
                android:text="@string/goto_mode_spi"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">
            <RadioButton android:id="@+id/goto_mode_friendly"
                android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1"
                android:button="@null" android:gravity="center" android:textColor="#FFFFFF"
                android:textSize="13sp" android:drawableTop="@drawable/ic_marker_friendly"
                android:drawablePadding="5dp" android:background="@drawable/goto_marker_cell_bg"
                android:text="@string/goto_mode_friendly"/>
            <Space android:layout_width="8dp" android:layout_height="wrap_content"/>
            <RadioButton android:id="@+id/goto_mode_hostile"
                android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1"
                android:button="@null" android:gravity="center" android:textColor="#FFFFFF"
                android:textSize="13sp" android:drawableTop="@drawable/ic_marker_hostile"
                android:drawablePadding="5dp" android:background="@drawable/goto_marker_cell_bg"
                android:text="@string/goto_mode_hostile"/>
            <Space android:layout_width="8dp" android:layout_height="wrap_content"/>
            <RadioButton android:id="@+id/goto_mode_neutral"
                android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1"
                android:button="@null" android:gravity="center" android:textColor="#FFFFFF"
                android:textSize="13sp" android:drawableTop="@drawable/ic_marker_neutral"
                android:drawablePadding="5dp" android:background="@drawable/goto_marker_cell_bg"
                android:text="@string/goto_mode_neutral"/>
            <Space android:layout_width="8dp" android:layout_height="wrap_content"/>
            <RadioButton android:id="@+id/goto_mode_unknown"
                android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1"
                android:button="@null" android:gravity="center" android:textColor="#FFFFFF"
                android:textSize="13sp" android:drawableTop="@drawable/ic_marker_unknown"
                android:drawablePadding="5dp" android:background="@drawable/goto_marker_cell_bg"
                android:text="@string/goto_mode_unknown"/>
        </LinearLayout>

        <!-- ===== 送出區：主/次分明（痛點②）===== -->
        <!-- 主：goto_btn_submit 放大上色（cyan），disabled 時走 goto_submit_primary_bg 的灰態。 -->
        <Button
            android:id="@+id/goto_btn_submit"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/goto_submit_primary_bg"
            android:textColor="#06222E"
            android:textSize="18sp"
            android:textStyle="bold"
            android:text="@string/goto_btn_submit"
            android:enabled="false"/>

        <!-- 次：goto_btn_atak_picker 做成 ghost 連結感，明顯弱於主鈕。 -->
        <Button
            android:id="@+id/goto_btn_atak_picker"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/goto_submit_secondary_bg"
            android:textColor="#BFBFBF"
            android:textSize="14sp"
            android:text="@string/goto_btn_atak_picker"
            android:enabled="false"/>

        <!-- ===== 最近輸入（US4）===== -->
        <LinearLayout
            android:id="@+id/goto_recent_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="18dp">

            <TextView
                android:id="@+id/goto_recent_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/goto_recent_header"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#2E2E2E"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/goto_recent_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/goto_recent_empty"
                android:textColor="#7C7C7C"
                android:textSize="13sp"
                android:padding="10dp"/>

            <LinearLayout
                android:id="@+id/goto_recent_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
